[
  {
    "$source": {
      "coll": "transactions",
      "connectionName": "democluster",
      "db": "fraud_detection"
    }
  },
  {
    "$match": {
      "operationType": {
        "$in": [
          "insert",
          "update",
          "replace"
        ]
      }
    }
  },
  {
    "$addFields": {
      "fullDocument.processed_at": "$wallTime"
    }
  },
  {
    "$replaceRoot": {
      "newRoot": "$fullDocument"
    }
  },
  {
    "$match": {
      "status": "pending"
    }
  },
  {
    "$lookup": {
      "as": "user_profile",
      "foreignField": "user_id",
      "from": {
        "coll": "user_profiles",
        "connectionName": "democluster",
        "db": "fraud_detection"
      },
      "localField": "user_id"
    }
  },
  {
    "$unwind": {
      "path": "$user_profile",
      "preserveNullAndEmptyArrays": true
    }
  },
  {
    "$addFields": {
      "fraud_indicators": [],
      "fraud_score": 0
    }
  },
  {
    "$addFields": {
      "fraud_indicators": {
        "$concatArrays": [
          "$fraud_indicators",
          {
            "$cond": [
              {
                "$and": [
                  {
                    "$ifNull": [
                      "$user_profile.patterns.avg_transaction_amount",
                      false
                    ]
                  },
                  {
                    "$gt": [
                      "$amount",
                      {
                        "$multiply": [
                          "$user_profile.patterns.avg_transaction_amount",
                          3
                        ]
                      }
                    ]
                  }
                ]
              },
              [
                "high_amount"
              ],
              []
            ]
          }
        ]
      }
    }
  },
  {
    "$addFields": {
      "fraud_indicators": {
        "$concatArrays": [
          "$fraud_indicators",
          {
            "$cond": [
              {
                "$and": [
                  {
                    "$ifNull": [
                      "$user_profile.patterns.frequent_locations",
                      false
                    ]
                  },
                  {
                    "$not": {
                      "$in": [
                        "$location.country",
                        {
                          "$map": {
                            "as": "loc",
                            "in": "$$loc.country",
                            "input": "$user_profile.patterns.frequent_locations"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              [
                "unusual_location"
              ],
              []
            ]
          }
        ]
      }
    }
  },
  {
    "$addFields": {
      "fraud_indicators": {
        "$concatArrays": [
          "$fraud_indicators",
          {
            "$cond": [
              {
                "$and": [
                  {
                    "$ifNull": [
                      "$user_profile.patterns.known_devices",
                      false
                    ]
                  },
                  {
                    "$not": {
                      "$in": [
                        "$device.device_id",
                        "$user_profile.patterns.known_devices"
                      ]
                    }
                  }
                ]
              },
              [
                "new_device"
              ],
              []
            ]
          }
        ]
      }
    }
  },
  {
    "$addFields": {
      "fraud_score": {
        "$add": [
          {
            "$cond": [
              {
                "$in": [
                  "high_amount",
                  "$fraud_indicators"
                ]
              },
              25,
              0
            ]
          },
          {
            "$cond": [
              {
                "$in": [
                  "unusual_location",
                  "$fraud_indicators"
                ]
              },
              30,
              0
            ]
          },
          {
            "$cond": [
              {
                "$in": [
                  "new_device",
                  "$fraud_indicators"
                ]
              },
              20,
              0
            ]
          }
        ]
      }
    }
  },
  {
    "$addFields": {
      "is_fraudulent": {
        "$gte": [
          "$fraud_score",
          70
        ]
      },
      "status": {
        "$cond": [
          {
            "$gte": [
              "$fraud_score",
              70
            ]
          },
          "flagged",
          "completed"
        ]
      }
    }
  },
  {
    "$match": {
      "is_fraudulent": true
    }
  },
  {
    "$merge": {
      "into": {
        "coll": "processed_transactions",
        "connectionName": "democluster",
        "db": "fraud_detection"
      },
      "whenMatched": "replace",
      "whenNotMatched": "insert"
    }
  }
]